	partition 'Data Dictionary' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "data_dictionary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Column", type text}, {"Type", type text}, {"Role", type text}, {"Missing", Int64.Type}, {"Levels", type text}, {"Note", type text}}, "en-US")
				in
				    Typed

