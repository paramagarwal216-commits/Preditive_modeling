	partition Respondents = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "respondents.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Respondent ID", Int64.Type}, {"Age", Int64.Type}, {"Gender", type text}, {"Marital Status", type text}, {"Occupation", type text}, {"Monthly Income", type text}, {"Educational Qualifications", type text}, {"Family size", Int64.Type}, {"Customer Type", type text}, {"latitude", type number}, {"longitude", type number}, {"Pin code", Int64.Type}, {"Output", type text}, {"Feedback", type text}, {"Income Order", Int64.Type}, {"Education Order", Int64.Type}, {"Age Band", type text}, {"Says Yes", Int64.Type}, {"Positive Feedback", Int64.Type}}, "en-US")
				in
				    Typed

