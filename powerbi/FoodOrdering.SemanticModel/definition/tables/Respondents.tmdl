table Respondents
	lineageTag: bd91a372-6307-4a1c-a7fe-bec49c635944

	measure Respondents = COUNTROWS ( Respondents )
		formatString: #,0
		lineageTag: afc8c244-2c01-4c71-9917-bfe9c70260e5

	measure 'Say Yes' = SUM ( Respondents[Says Yes] )
		formatString: #,0
		lineageTag: 7e4f300c-6d2e-4f43-9715-459069bea5be

	measure 'Yes Rate' = DIVIDE ( [Say Yes], [Respondents] )
		formatString: 0.0%
		lineageTag: 75434aee-bece-422b-bc8b-ce8e14d7b97d

	measure 'Positive Feedback Rate' = DIVIDE ( SUM ( Respondents[Positive Feedback] ), [Respondents] )
		formatString: 0.0%
		lineageTag: dd2675e5-6d88-4963-8ff1-bdebeb62ed85

	measure 'Average Age' = AVERAGE ( Respondents[Age] )
		formatString: 0.0
		lineageTag: e0e3c91e-2116-4ffa-9d18-6a33bd1bb740

	measure 'Average Family Size' = AVERAGE ( Respondents[Family size] )
		formatString: 0.0
		lineageTag: 879395f5-0f99-43b8-a58a-495548b39779

	measure 'Yes Rate vs All' = [Yes Rate] - CALCULATE ( [Yes Rate], ALL ( Respondents ) )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 0308295e-d854-44b0-a4f7-47f5ae533f3f

	measure 'Avg Latitude' = AVERAGE ( Respondents[latitude] )
		formatString: 0.0000
		lineageTag: 0a11269e-ad55-4d1c-b59b-89bf943513b6

	measure 'Avg Longitude' = AVERAGE ( Respondents[longitude] )
		formatString: 0.0000
		lineageTag: 99840166-6494-4346-83d8-837a83514480

