model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Respondents", "Model Scores", "Fold Scores", "Feature Importance", "Confusion", "Association Tests", "Data Dictionary"]

annotation PBI_ProTooling = ["DevMode"]

ref table Respondents
ref table 'Model Scores'
ref table 'Fold Scores'
ref table 'Feature Importance'
ref table Confusion
ref table 'Association Tests'
ref table 'Data Dictionary'

